# Copie para .env e ajuste. Nunca versione o .env.

# --- PostgreSQL (usado pelo docker-compose e pelo backend) ---
POSTGRES_USER=secondbrain
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=secondbrain
POSTGRES_PORT=5432

# URL de conexão do backend (driver psycopg 3)
DATABASE_URL=postgresql+psycopg://secondbrain:change-me-locally@localhost:5432/secondbrain

# --- Backend ---
APP_ENV=development
API_PREFIX=/api
# Lista separada por vírgulas
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Documentos (PDF) ---
# Diretório dos PDFs originais. Relativo = a partir de onde o backend é iniciado (backend/).
# Mantenha fora de pastas públicas do frontend. Faça backup junto com o banco.
DOCUMENT_STORAGE_PATH=./storage/documents
# Tamanho máximo de upload (MB) e máximo de páginas por PDF
MAX_UPLOAD_MB=20
MAX_DOCUMENT_PAGES=500

# --- Processamento em segundo plano ---
# Documentos são processados por um pool de threads dentro da própria API (sem Redis/Celery).
DOCUMENT_PROCESSING_ENABLED=true
# Quantos documentos podem ser processados ao mesmo tempo
DOCUMENT_WORKERS=2
# Ao iniciar, reenfileira documentos pending e devolve processing para pending.
# Pressupõe UM único processo da API (não use com vários workers do uvicorn).
RECOVER_ON_STARTUP=true

# --- Segmentação em trechos (chunks), em caracteres ---
# Máximo por trecho, sobreposição entre trechos da mesma página e mínimo de texto útil por página.
# Vale para novos documentos; para aplicar a documentos já importados rode:
#   python -m app.cli rebuild-chunks --all
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP_CHARS=200
CHUNK_MIN_CHARS=50

# --- Frontend ---
# Vazio usa o proxy do Vite (/api -> backend). Defina para apontar para outra URL.
VITE_API_URL=
VITE_BACKEND_PROXY=http://localhost:8000

# --- Fases futuras (não usadas na Fase 1) ---
# EMBEDDING_DIMENSIONS=1536
