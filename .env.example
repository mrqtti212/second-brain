# Copie para .env e ajuste. Nunca versione o .env.

# --- PostgreSQL (usado pelo docker-compose e pelo backend) ---
POSTGRES_USER=secondbrain
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=secondbrain
POSTGRES_PORT=5432

# URL de conexão do backend (driver psycopg 3)
DATABASE_URL=postgresql+psycopg://secondbrain:change-me-locally@localhost:5432/secondbrain

# --- Backend ---
APP_ENV=development
API_PREFIX=/api
# Lista separada por vírgulas
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Documentos (PDF) ---
# Diretório dos PDFs originais. Relativo = a partir de onde o backend é iniciado (backend/).
# Mantenha fora de pastas públicas do frontend. Faça backup junto com o banco.
DOCUMENT_STORAGE_PATH=./storage/documents
# Tamanho máximo de upload (MB) e máximo de páginas por PDF
MAX_UPLOAD_MB=20
MAX_DOCUMENT_PAGES=500

# --- Processamento em segundo plano ---
# Documentos são processados por um pool de threads dentro da própria API (sem Redis/Celery).
DOCUMENT_PROCESSING_ENABLED=true
# Quantos documentos podem ser processados ao mesmo tempo
DOCUMENT_WORKERS=2
# Ao iniciar, reenfileira documentos pending e devolve processing para pending.
# Pressupõe UM único processo da API (não use com vários workers do uvicorn).
RECOVER_ON_STARTUP=true

# --- Segmentação em trechos (chunks), em caracteres ---
# Máximo por trecho, sobreposição entre trechos da mesma página e mínimo de texto útil por página.
# Vale para novos documentos; para aplicar a documentos já importados rode:
#   python -m app.cli rebuild-chunks --all
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP_CHARS=200
CHUNK_MIN_CHARS=50

# --- Frontend ---
# Pasta do frontend compilado (frontend/dist) servida pela própria API, numa porta só.
# Vazio = desligado (use `npm run dev`). O scripts/run-app.sh define isto sozinho.
FRONTEND_DIST_PATH=
# Vazio usa o proxy do Vite (/api -> backend). Defina para apontar para outra URL.
VITE_API_URL=
VITE_BACKEND_PROXY=http://localhost:8000

# --- Embeddings dos trechos (em desenvolvimento) ---
# Desligados por padrão: nada é gerado nem consultado. Sem API externa e sem credenciais.
# Para ligar com o provedor local (modelo em CPU, o texto dos documentos NUNCA sai da máquina):
#   1. pip install -r requirements-embeddings.txt        (no venv do backend; dependências opcionais)
#   2. python -m app.cli download-embedding-model        (manual; ~490 MB; revisão fixa e SHA-256 verificados)
#   3. EMBEDDINGS_ENABLED=true  (EMBEDDING_PROVIDER=local já é o padrão) e reinicie a API
# Precisa de cerca de 1 GB de memória livre. `fake` é um provedor determinístico só para
# desenvolvimento e testes (não é semântico).
EMBEDDINGS_ENABLED=false
EMBEDDING_PROVIDER=local
# O provedor local só suporta este modelo (revisão 614241f6, 384 dimensões).
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Onde ficam os arquivos do modelo (relativo ao diretório de execução; ignorado pelo Git).
EMBEDDING_MODEL_PATH=models/multilingual-e5-small
# Threads do onnxruntime em CPU (0 = automático, até 4).
EMBEDDING_THREADS=0
# Fixa no banco (coluna vector(384)); outro valor exige uma migration nova.
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=16
# Geração automática depois que o documento fica `completed`, em um pool próprio (não atrasa o
# processamento de documentos). Só erros passageiros são repetidos, com espera que dobra a cada tentativa.
EMBEDDING_WORKERS=1
EMBEDDING_MAX_ATTEMPTS=3
EMBEDDING_RETRY_BACKOFF_SECONDS=1.0
# Pendências (inclusive as que ficaram para trás num reinício) são retomadas na inicialização
# quando RECOVER_ON_STARTUP=true, ou à mão:  python -m app.cli embed-pending
